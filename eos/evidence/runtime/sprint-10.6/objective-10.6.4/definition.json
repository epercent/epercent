      "assignmentStatus",
      "engineeringMissionId",
      "assignedOffice",
      "assignedWorkforce",
      "assignedAgentOrCanonicalWorkforceIdentity",
      "requiredCapabilities",
      "matchedCapabilities",
      "unmatchedCapabilities",
      "assignmentReasons",
      "governanceState",
      "blockingConditions",
      "provenance",
      "nextStep"
